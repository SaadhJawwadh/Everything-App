<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_shape"
    android:clipToOutline="true"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Active Content Container -->
    <LinearLayout
        android:id="@+id/finance_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Flex LinearLayout Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_finance_label"
                android:textColor="@color/widget_text_primary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/widget_account_chip"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_badge_tonal_shape"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11.5sp"
                tools:text="Daily" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Scan Receipt Action Button -->
            <FrameLayout
                android:id="@+id/widget_scan_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:background="@drawable/widget_cta_secondary_shape"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_scan_receipt"
                    android:src="@drawable/ic_receipt_scanner_rounded"
                    android:tint="@color/widget_on_secondary_container" />
            </FrameLayout>

            <!-- Add Transaction Action Button -->
            <FrameLayout
                android:id="@+id/widget_add_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:background="@drawable/widget_cta_primary_shape"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_add_transaction"
                    android:src="@drawable/ic_add_small"
                    android:tint="@color/widget_on_primary" />
            </FrameLayout>
        </LinearLayout>

        <!-- Spendings Overview Grid -->
        <LinearLayout
            android:id="@+id/widget_overview_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.03"
                    android:maxLines="1"
                    android:text="@string/widget_today_label"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_today_spent"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="1dp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeMinTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="16sp"
                    tools:text="$28" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.1"
                android:orientation="vertical"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.03"
                    android:maxLines="1"
                    android:text="@string/widget_spent_month_label"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_month_spent"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="1dp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeMinTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="16sp"
                    tools:text="$640" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.03"
                    android:maxLines="1"
                    android:text="@string/widget_net_label"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_month_net_positive"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="1dp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeMinTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textColor="@color/widget_income"
                    android:textSize="16sp"
                    android:visibility="visible"
                    tools:text="+$1,860" />

                <TextView
                    android:id="@+id/widget_month_net_negative"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="1dp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeMinTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textColor="@color/widget_expense"
                    android:textSize="16sp"
                    android:visibility="gone"
                    tools:text="-$120" />
            </LinearLayout>
        </LinearLayout>

        <!-- Analytics Bottom Highlight Card -->
        <LinearLayout
            android:id="@+id/widget_analytics_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_subcard_shape"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.03"
                    android:maxLines="1"
                    android:text="@string/widget_month_est_label"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/widget_forecast_amount"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="1dp"
                    android:autoSizeMaxTextSize="15sp"
                    android:autoSizeMinTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="15sp"
                    tools:text="$1,420" />

                <TextView
                    android:id="@+id/widget_forecast_trend_normal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/widget_pace_on_track"
                    android:textColor="@color/widget_income"
                    android:textSize="11sp"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/widget_forecast_trend_alert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/widget_pace_fast"
                    android:textColor="@color/widget_expense"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Dynamic Mini Sparkline Curve Plot -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:layout_marginStart="8dp">

                <ImageView
                    android:id="@+id/widget_sparkline_plot"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_month_est_label"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/widget_sparkline_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/widget_sparkline_empty_hint"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Locked / Disabled State Container -->
    <LinearLayout
        android:id="@+id/finance_locked_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/widget_finances_disabled"
            android:src="@drawable/ic_shortcut_new_transaction"
            android:tint="@color/widget_primary" />

        <TextView
            android:id="@+id/finance_locked_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/widget_finances_disabled"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
