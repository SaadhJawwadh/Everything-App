<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_shape"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans_flex"
                android:text="Finances"
                android:textColor="@color/widget_text_primary"
                android:textSize="17sp"
                android:letterSpacing="0.01"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_category_chip_shape"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:fontFamily="@font/google_sans_flex"
                android:text="Daily Cash"
                android:textColor="@color/widget_on_primary_container"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- New Note Shortcut Button -->
            <FrameLayout
                android:id="@+id/widget_note_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_category_chip_shape"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="New Note"
                    android:src="@drawable/ic_shortcut_new_note"
                    android:tint="@color/widget_on_primary_container" />
            </FrameLayout>

            <!-- Add Transaction Action Button -->
            <FrameLayout
                android:id="@+id/widget_add_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_add_button_shape"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="Add Transaction"
                    android:src="@drawable/ic_add_small"
                    android:tint="@color/widget_on_primary_container" />
            </FrameLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Spendings Overview Grid -->
    <LinearLayout
        android:id="@+id/widget_overview_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TODAY"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10.5sp"
                android:letterSpacing="0.04"
                android:fontFamily="@font/google_sans_flex"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_today_spent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/google_sans_flex"
                android:text="$0.00"
                android:textColor="@color/widget_text_primary"
                android:textSize="15.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPENT (MO)"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10.5sp"
                android:letterSpacing="0.04"
                android:fontFamily="@font/google_sans_flex"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_month_spent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/google_sans_flex"
                android:text="$0.00"
                android:textColor="@color/widget_text_primary"
                android:textSize="15.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NET"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10.5sp"
                android:letterSpacing="0.04"
                android:fontFamily="@font/google_sans_flex"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_month_net_positive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/google_sans_flex"
                android:text="$0.00"
                android:textColor="@color/widget_income"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <TextView
                android:id="@+id/widget_month_net_negative"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/google_sans_flex"
                android:text="$0.00"
                android:textColor="@color/widget_expense"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Analytics Bottom Highlight Card (Mini Sparkline Plot & Ongoing Month Projection) -->
    <LinearLayout
        android:id="@+id/widget_analytics_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_subcard_shape"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THIS MONTH EST"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp"
                android:letterSpacing="0.04"
                android:fontFamily="@font/google_sans_flex"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_forecast_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/google_sans_flex"
                android:text="$0.00"
                android:textColor="@color/widget_text_primary"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_forecast_trend_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/google_sans_flex"
                android:text="On Track"
                android:textColor="@color/widget_income"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <TextView
                android:id="@+id/widget_forecast_trend_alert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/google_sans_flex"
                android:text="Pacing Fast"
                android:textColor="@color/widget_expense"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Dynamic Mini Sparkline Curve Plot -->
        <ImageView
            android:id="@+id/widget_sparkline_plot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:layout_marginStart="6dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

</LinearLayout>
