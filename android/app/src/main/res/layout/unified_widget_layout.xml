<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_shape"
    android:baselineAligned="false"
    android:clipToOutline="true"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Left Column: Personal Finance Domain -->
    <LinearLayout
        android:id="@+id/unified_finance_section"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <!-- Finance Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_finance_label"
                android:textColor="@color/widget_text_primary"
                android:textSize="15sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Quick Add Transaction Button -->
            <FrameLayout
                android:id="@+id/unified_btn_add_tx"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:background="@drawable/widget_cta_primary_shape"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_add_transaction"
                    android:src="@drawable/ic_add_small"
                    android:tint="@color/widget_on_primary" />
            </FrameLayout>
        </LinearLayout>

        <!-- Net Cash Flow Label & Metric -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.03"
            android:maxLines="1"
            android:text="@string/widget_net_label"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/unified_net_balance"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="--"
            android:textColor="@color/widget_income"
            android:textSize="18sp" />

        <!-- Today Spend Badge -->
        <TextView
            android:id="@+id/unified_today_spent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_badge_tonal_shape"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="@string/widget_today_label"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/unified_month_spent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="@string/widget_spent_month_label"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Divider Line -->
    <FrameLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@color/widget_divider" />

    <!-- Right Column: Notes & Checklists Domain -->
    <LinearLayout
        android:id="@+id/unified_notes_section"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <!-- Notes Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_todo_label"
                android:textColor="@color/widget_text_primary"
                android:textSize="15sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- New Note Button -->
            <FrameLayout
                android:id="@+id/unified_btn_new_note"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:background="@drawable/widget_cta_secondary_shape"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/widget_new_note"
                    android:src="@drawable/ic_note_add_rounded"
                    android:tint="@color/widget_on_secondary_container" />
            </FrameLayout>
        </LinearLayout>

        <!-- Active Note Title / List Selector Pill -->
        <LinearLayout
            android:id="@+id/unified_list_selector"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/widget_cta_secondary_shape"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/unified_note_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:maxWidth="110dp"
                android:text="@string/widget_checklist_fallback"
                android:textColor="@color/widget_on_secondary_container"
                android:textSize="11.5sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="2dp"
                android:contentDescription="@string/widget_picker_title"
                android:src="@drawable/ic_arrow_drop_down"
                android:tint="@color/widget_on_secondary_container" />
        </LinearLayout>

        <!-- Checklist Item 1 -->
        <LinearLayout
            android:id="@+id/unified_task_1_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/unified_task_1_check"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="13dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/widget_new_task"
                android:src="@drawable/ic_checkbox_unchecked" />

            <TextView
                android:id="@+id/unified_task_1_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Checklist Item 2 -->
        <LinearLayout
            android:id="@+id/unified_task_2_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/unified_task_2_check"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="13dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/widget_new_task"
                android:src="@drawable/ic_checkbox_unchecked" />

            <TextView
                android:id="@+id/unified_task_2_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Empty Notes Fallback -->
        <TextView
            android:id="@+id/unified_notes_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:text="@string/widget_no_pending_tasks"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11.5sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
