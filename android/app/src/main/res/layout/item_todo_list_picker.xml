<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/picker_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?android:attr/selectableItemBackground">

    <!-- Leading Icon / Pill -->
    <FrameLayout
        android:id="@+id/picker_item_icon_container"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_category_chip_shape">

        <ImageView
            android:id="@+id/picker_item_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_checklist"
            android:tint="@color/widget_on_primary_container"
            android:contentDescription="List Icon" />
    </FrameLayout>

    <!-- List Title & Item Count Subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/picker_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_flex"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/picker_item_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/google_sans_flex"
            android:textSize="12sp"
            android:textColor="@color/widget_text_secondary"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Selection Checkmark -->
    <ImageView
        android:id="@+id/picker_item_check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_checkbox_checked"
        android:tint="@color/widget_primary"
        android:visibility="gone"
        android:contentDescription="Selected" />

</LinearLayout>
