<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/picker_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Leading Icon / Pill -->
    <FrameLayout
        android:id="@+id/picker_item_icon_container"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_cta_secondary_shape">

        <ImageView
            android:id="@+id/picker_item_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@string/widget_picker_title"
            android:src="@drawable/ic_checklist"
            android:tint="@color/widget_on_secondary_container" />
    </FrameLayout>

    <!-- List Title & Item Count Subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/picker_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/picker_item_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Selection Checkmark -->
    <ImageView
        android:id="@+id/picker_item_check"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@string/widget_picker_title"
        android:src="@drawable/ic_check_rounded"
        android:tint="@color/widget_primary"
        android:visibility="gone" />

</LinearLayout>
